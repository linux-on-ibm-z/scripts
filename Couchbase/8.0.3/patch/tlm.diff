diff --git a/cmake/Modules/FindCouchbaseGo.cmake b/cmake/Modules/FindCouchbaseGo.cmake
index 85157f9..4f61071 100644
--- a/cmake/Modules/FindCouchbaseGo.cmake
+++ b/cmake/Modules/FindCouchbaseGo.cmake
@@ -150,6 +150,38 @@ IF (NOT FindCouchbaseGo_INCLUDED)
   #   USAGE - usage of TARGET
   #   UNSHIPPED - true if TARGET is not a shipped deliverable
   MACRO (GET_GOROOT VERSION var ver TARGET USAGE UNSHIPPED)
+    # ================== [s390x ] ==================
+    _DETERMINE_ARCH (_arch)
+    IF (_arch STREQUAL "s390x")
+      IF (DEFINED ENV{GOROOT})
+        SET (${var} "$ENV{GOROOT}")
+      ELSE ()
+        EXECUTE_PROCESS (
+          COMMAND go env GOROOT
+          OUTPUT_VARIABLE _sys_goroot
+          OUTPUT_STRIP_TRAILING_WHITESPACE
+          ERROR_QUIET
+        )
+        IF (_sys_goroot)
+          SET (${var} "${_sys_goroot}")
+        ELSE ()
+          SET (${var} "/usr/local/go") # peace mind
+        ENDIF ()
+      ENDIF ()
+
+      SET (${ver} "1.26.3") # set go version
+      MESSAGE (STATUS "s390x Porting [EARLY INTERCEPT]: Forcing GOROOT to system path: ${${var}}")
+
+      SET (_ver_final "1.26.3")
+      SAVE_GO_TARGET ("1.26.3" "${VERSION}" ${TARGET} ${USAGE} ${UNSHIPPED})
+
+      SET (_is_s390x_intercepted TRUE)
+    ELSE ()
+      SET (_is_s390x_intercepted FALSE)
+    ENDIF ()
+    # ================== [s390x ] ==================
+
+    IF (NOT _is_s390x_intercepted)
     SET (_request_version ${VERSION})
 
     # If one of the constant Go versions is specified, read in the
@@ -219,6 +251,7 @@ IF (NOT FindCouchbaseGo_INCLUDED)
     GET_GO_VERSION ("${_ver_final}" ${var})
     SET (${ver} ${_ver_final})
     SAVE_GO_TARGET (${_ver_final} ${_request_version} ${TARGET} ${USAGE} ${UNSHIPPED})
+    ENDIF (NOT _is_s390x_intercepted)
   ENDMACRO (GET_GOROOT)
 
   # Save a Go version usage, keyed by final Go version, as well as updating the
