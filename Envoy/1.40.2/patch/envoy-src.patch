+  // A key built for 1.2.3.4:1111 -> 5.6.7.8:2222 must serialize to this exact wire image.
+  // sport/dport are htons(port) stored in the low 16 bits of a uint32_t, so the in-memory
+  // layout differs between little-endian and big-endian hosts.
   Address::Ipv4Instance local("1.2.3.4", 1111);
   Address::Ipv4Instance peer("5.6.7.8", 2222);
