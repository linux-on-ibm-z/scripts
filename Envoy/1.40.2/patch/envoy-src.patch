+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
   const uint8_t expected[sizeof(SockKey)] = {
       0x01, 0x02, 0x03, 0x04, // sip4 1.2.3.4 network order
       0x05, 0x06, 0x07, 0x08, // dip4 5.6.7.8 network order
