+      0x00, 0x00, 0x04, 0x57, // source port htons(1111) in the low 16 bits (big-endian)
+      0x00, 0x00, 0x08, 0xae, // destination port htons(2222) in the low 16 bits (big-endian)
   };
+#else
+  const uint8_t expected[sizeof(SockKey)] = {
+      0x01, 0x02, 0x03, 0x04, // sip4 1.2.3.4 network order
+      0x05, 0x06, 0x07, 0x08, // dip4 5.6.7.8 network order
+      0x01, 0x00, 0x00, 0x00, // family 1, pads
+      0x04, 0x57, 0x00, 0x00, // source port htons(1111) in the low 16 bits (little-endian)
+      0x08, 0xae, 0x00, 0x00, // destination port htons(2222) in the low 16 bits (little-endian)
+  };
+#endif
   EXPECT_EQ(0, std::memcmp(&key, expected, sizeof(SockKey)));
 }
 
