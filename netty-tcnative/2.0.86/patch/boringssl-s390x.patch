@@ -27,6 +27,13 @@
 #include "ssl_private.h"
 #include "sslcredential.h"
 
+#ifdef OPENSSL_IS_BORINGSSL
+/* Not present in the s390x BoringSSL fork (patch-s390x-Sep2024); resolved at runtime. */
+__attribute__((weak)) extern int  SSL_CREDENTIAL_set1_trust_anchor_id(SSL_CREDENTIAL*, const uint8_t*, size_t);
+__attribute__((weak)) extern void SSL_CREDENTIAL_set_must_match_issuer(SSL_CREDENTIAL*, int);
+__attribute__((weak)) extern int  SSL_CREDENTIAL_set1_certificate_properties(SSL_CREDENTIAL*, CRYPTO_BUFFER*);
+#endif
+
 #define SSLCREDENTIAL_CLASSNAME "io/netty/internal/tcnative/SSLCredential"
 
 // Helper functions
@@ -203,6 +210,10 @@ TCN_IMPLEMENT_CALL(void, SSLCredential, setSigningAlgorithmPrefs)(TCN_STDARGS, j
 
 TCN_IMPLEMENT_CALL(void, SSLCredential, setCertificateProperties)(TCN_STDARGS, jlong cred, jbyteArray cert_props) {
 #ifdef OPENSSL_IS_BORINGSSL
+    if (SSL_CREDENTIAL_set1_certificate_properties == NULL) {
+        tcn_ThrowUnsupportedOperationException(e, "SSL_CREDENTIAL_set1_certificate_properties not available.");
+        return;
+    }
     SSL_CREDENTIAL* c = (SSL_CREDENTIAL*)(intptr_t)cred;
     TCN_CHECK_NULL(c, credential, /* void */);
     TCN_CHECK_NULL(cert_props, certificateProperties, /* void */);
@@ -265,6 +276,10 @@ TCN_IMPLEMENT_CALL(void, SSLCredential, setSignedCertTimestampList)(TCN_STDARGS,
 
 TCN_IMPLEMENT_CALL(void, SSLCredential, setMustMatchIssuer)(TCN_STDARGS, jlong cred, jboolean match) {
 #ifdef OPENSSL_IS_BORINGSSL
+    if (SSL_CREDENTIAL_set_must_match_issuer == NULL) {
+        tcn_ThrowUnsupportedOperationException(e, "SSL_CREDENTIAL_set_must_match_issuer not available.");
+        return;
+    }
     SSL_CREDENTIAL* c = (SSL_CREDENTIAL*)(intptr_t)cred;
     TCN_CHECK_NULL(c, credential, /* void */);
     SSL_CREDENTIAL_set_must_match_issuer(c, match == JNI_TRUE ? 1 : 0);
@@ -276,6 +291,10 @@ TCN_IMPLEMENT_CALL(void, SSLCredential, setMustMatchIssuer)(TCN_STDARGS, jlong c
 // Trust anchor configuration
 TCN_IMPLEMENT_CALL(void, SSLCredential, setTrustAnchorId)(TCN_STDARGS, jlong cred, jbyteArray id) {
 #ifdef OPENSSL_IS_BORINGSSL
+    if (SSL_CREDENTIAL_set1_trust_anchor_id == NULL) {
+        tcn_ThrowUnsupportedOperationException(e, "SSL_CREDENTIAL_set1_trust_anchor_id not available.");
+        return;
+    }
     SSL_CREDENTIAL* c = (SSL_CREDENTIAL*)(intptr_t)cred;
     TCN_CHECK_NULL(c, credential, /* void */);
     TCN_CHECK_NULL(id, trustAnchorId, /* void */);
