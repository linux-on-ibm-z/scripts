pipeline {
    agent {
        docker {
            image 'osuosl/ubuntu-s390x:22.04'
            label 's390x-docker2'
        }
    }
    
    triggers {
        // Trigger build immediately when GitHub pushes a webhook notification
        githubPush()
    }
    
    stages {
        stage('Checkout Envoy') {
			options {
				timeout(time: 5, unit: 'MINUTES')
			}
            steps {
                script {
                    dir('envoy') {
						// Shallow clone of repository
						checkout([
							$class: 'GitSCM',
							branches: [[name: '*/main']],
							extensions: [
								[$class: 'CloneOption', depth: 1, noTags: false, shallow: true]
							],
							userRemoteConfigs: [[url: 'https://github.com/envoyproxy/envoy.git']]
						])
                    }    
                }
            }
        }
        
                
        stage('Build Envoy') {
            steps {
                script {
					try {
	                    sh '''
							wget -O build_envoy.sh https://raw.githubusercontent.com/linux-on-ibm-z/scripts/refs/heads/master/CI/Envoy/build_envoy.sh
							ls -l
							bash build_envoy.sh -y 
						'''
					} catch (Exception e) {
                		currentBuild.result = 'FAILURE'
                		echo "Envoy build failed: ${e.message}"
                		throw e
				    }
                }
            }
        }
    }
    
    post {
        always {
            cleanWs()
        }
        failure {
            emailext(
                to: 'aborkar@us.ibm.com,Namrata.Bhave@ibm.com,Sangita.Nalkar@ibm.com',
                subject: "Jenkins Build FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
The Jenkins pipeline job has failed.

Job:        ${env.JOB_NAME}
Build:      #${env.BUILD_NUMBER}
Status:     ${currentBuild.currentResult}
Duration:   ${currentBuild.durationString}
Build URL:  ${env.BUILD_URL}

Please check the console output for details.
""",
                mimeType: 'text/plain'
            )
        }
    }
}
