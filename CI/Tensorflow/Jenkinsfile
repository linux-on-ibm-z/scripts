pipeline {
    agent {
        docker {
            image 'osuosl/ubuntu-s390x:22.04'
            label 's390x-docker1'
        }
    }
    
     triggers {
        // Trigger build immediately when GitHub pushes a webhook notification
        githubPush()
    }
    
    stages {
        stage('Checkout Tensorflow') {
			options {
				timeout(time: 5, unit: 'MINUTES')
			}
            steps {
                script {
                    dir('tensorflow') {
						// Shallow clone of repository
						checkout([
							$class: 'GitSCM',
							branches: [[name: '*/master']],
							extensions: [
								[$class: 'CloneOption', depth: 1, noTags: false, shallow: true]
							],
							userRemoteConfigs: [[url: 'https://github.com/tensorflow/tensorflow.git']]
						])
                    }    
                }
            }
        }
        
        stage('Build Tensorflow') {
            steps {
                script {
					try {
						sh '''
							pwd
							ls
							wget -O build_tensorflow.sh https://raw.githubusercontent.com/linux-on-ibm-z/scripts/refs/heads/master/CI/Tensorflow/build_tensorflow.sh
							bash build_tensorflow.sh -y 2>&1 | tee tf.log
							grep "Build completed successfully" tf.log
		                    if [ $? -eq 0 ]; then exit 0; else exit 1; fi
						'''
					} catch (Exception e) {
                		currentBuild.result = 'FAILURE'
                		echo "Tensorflow build failed: ${e.message}"
                		throw e
				    }
                }
            }
        }
		stage('Archive Artifacts') {
            steps {
                script {
                    // Verify .whl files exist before archiving
                    sh 'ls -lh tensorflow_whl/*.whl'
                    archiveArtifacts artifacts: 'tensorflow_whl/*.whl', fingerprint: true
                }
            }
        }
    }
    
    post {
        always {
            cleanWs()
        }
        failure {
            emailext(
                to: 'aborkar@us.ibm.com,Namrata.Bhave@ibm.com,Sangita.Nalkar@ibm.com',
                subject: "Jenkins Build FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
The Jenkins pipeline job has failed.

Job:        ${env.JOB_NAME}
Build:      #${env.BUILD_NUMBER}
Status:     ${currentBuild.currentResult}
Duration:   ${currentBuild.durationString}
Build URL:  ${env.BUILD_URL}

Please check the console output for details.
""",
                mimeType: 'text/plain'
            )
        }
    }
}
