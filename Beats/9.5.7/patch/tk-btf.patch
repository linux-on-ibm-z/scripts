+
+func TestRegistersS390x_GetFuncParamRegister(t *testing.T) {
+	regs, err := getRegistersResolver("s390x")
+	require.NoError(t, err)
+
+	cases := []struct {
+		name       string
+		reg        string
+		paramIndex int
+		err        error
+	}{
+		{
+			name:       "s390x_param_0",
+			reg:        "%r2",
+			paramIndex: 0,
+			err:        nil,
+		},
+		{
+			name:       "s390x_param_1",
+			reg:        "%r3",
+			paramIndex: 1,
+			err:        nil,
+		},
+		{
+			name:       "s390x_param_2",
+			reg:        "%r4",
+			paramIndex: 2,
+			err:        nil,
+		},
+		{
+			name:       "s390x_param_3",
+			reg:        "%r5",
+			paramIndex: 3,
+			err:        nil,
+		},
+		{
+			name:       "s390x_param_4",
+			reg:        "%r6",
+			paramIndex: 4,
+			err:        nil,
+		},
+		{
+			name:       "s390x_param_5",
+			reg:        "",
+			paramIndex: 5,
+			err:        ErrUnsupportedFuncParamIndex,
+		},
+	}
+
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			reg, err := regs.GetFuncParamRegister(c.paramIndex)
+			require.Equal(t, c.reg, reg)
+			require.ErrorIs(t, err, c.err)
+		})
+	}
+}
+
+func TestRegistersS390x_GetReturnRegister(t *testing.T) {
+	regs, err := getRegistersResolver("s390x")
+	require.NoError(t, err)
+
+	require.Equal(t, regs.GetFuncReturnRegister(), "%r2")
+}
