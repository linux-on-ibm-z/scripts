diff --git a/registers.go b/registers.go
index 67e6a1d..65290da 100644
--- a/registers.go
+++ b/registers.go
@@ -42,6 +42,8 @@ func getRegistersResolver(arch string) (registersResolver, error) {
 		return &registersAmd64{}, nil
 	case "arm64":
 		return &registersArm64{}, nil
+	case "s390x":
+		return &registersS390x{}, nil
 	default:
 		return nil, fmt.Errorf("%s not supported: %w", arch, ErrUnsupportedArch)
 	}
@@ -98,3 +100,28 @@ func (*registersArm64) GetFuncParamRegister(paramIndex int) (string, error) {
 func (*registersArm64) GetFuncReturnRegister() string {
 	return "%x0"
 }
+
+// registersS390x is the registersResolver implementation for s390x architecture.
+// The s390x ELF ABI passes the first five integer arguments in r2-r6 and returns the result in r2.
+type registersS390x struct{}
+
+func (*registersS390x) GetFuncParamRegister(paramIndex int) (string, error) {
+	switch paramIndex {
+	case 0:
+		return "%r2", nil
+	case 1:
+		return "%r3", nil
+	case 2:
+		return "%r4", nil
+	case 3:
+		return "%r5", nil
+	case 4:
+		return "%r6", nil
+	default:
+		return "", ErrUnsupportedFuncParamIndex
+	}
+}
+
+func (*registersS390x) GetFuncReturnRegister() string {
+	return "%r2"
+}
