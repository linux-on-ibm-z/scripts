diff --git a/images/local-path-helper/stage-binary-and-deps.sh b/images/local-path-helper/stage-binary-and-deps.sh
index 88fac24..8c6b8a8 100755
--- a/images/local-path-helper/stage-binary-and-deps.sh
+++ b/images/local-path-helper/stage-binary-and-deps.sh
@@ -78,7 +78,7 @@ binary_to_libraries() {
     | awk '{print $1}' \
     `# linux-vdso.so.1 is a special virtual shared object from the kernel` \
     `# see: http://man7.org/linux/man-pages/man7/vdso.7.html` \
-    | grep -v 'linux-vdso.so.1'
+    | grep -v -e 'linux-vdso.so.1' -e 'linux-vdso64.so.1'
 }
 
 # main script logic
diff --git a/images/base/Dockerfile b/images/base/Dockerfile
index 192e1ac..49f1dfc 100644
--- a/images/base/Dockerfile
+++ b/images/base/Dockerfile
@@ -110,10 +110,22 @@ COPY --chmod=0755 scripts/third_party/gimme/gimme /usr/local/bin/
 COPY --chmod=0755 scripts/target-cc /usr/local/bin/
 # tools needed at build-time only
-# first ensure we can install packages for both architectures
+# install native/cross dependencies only for the requested target architecture
-RUN dpkg --add-architecture arm64 && dpkg --add-architecture amd64 \
-    && clean-install bash ca-certificates curl git make pkg-config \
-    build-essential crossbuild-essential-amd64 crossbuild-essential-arm64 \
-    libseccomp-dev:amd64 libseccomp-dev:arm64
+ARG TARGETARCH
+RUN set -eux; \
+    build_arch="$(dpkg --print-architecture)"; \
+    packages="bash ca-certificates curl git make pkg-config build-essential"; \
+    case "$TARGETARCH" in \
+      amd64|arm64|s390x) \
+        if [ "$build_arch" = "$TARGETARCH" ]; then \
+          packages="$packages libseccomp-dev"; \
+        else \
+          dpkg --add-architecture "$TARGETARCH"; \
+          packages="$packages crossbuild-essential-$TARGETARCH libseccomp-dev:$TARGETARCH"; \
+        fi; \
+        ;; \
+      *) echo "unsupported TARGETARCH=$TARGETARCH"; exit 1 ;; \
+    esac; \
+    clean-install $packages
 # set by makefile to .go-version
 ARG GO_VERSION
 RUN eval "$(gimme "${GO_VERSION}")" \
diff --git a/images/base/scripts/target-cc b/images/base/scripts/target-cc
--- a/images/base/scripts/target-cc
+++ b/images/base/scripts/target-cc
@@ -24,6 +24,8 @@ case $TARGETARCH in
     echo -n 'aarch64-linux-gnu-gcc' ;;
   amd64)
     echo -n 'x86_64-linux-gnu-gcc' ;;
+  s390x)
+    echo -n 's390x-linux-gnu-gcc' ;;
   *)
     exit 1 ;;
 esac
