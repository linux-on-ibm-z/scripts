diff --git a/cmake/flags.cmake b/cmake/flags.cmake
index 262824a5..515e3adc 100644
--- a/cmake/flags.cmake
+++ b/cmake/flags.cmake
@@ -76,10 +76,34 @@ function(setupBuildFlags)
       # Debug builds. Undefine first to override any default level (the macOS
       # SDK defaults to 2) without a redefinition warning. C libraries that do
       # not support level 3 (macOS, older glibc) treat it as level 2.
+      #
+      # Disabled on s390x: building osquery with fortification enabled at any
+      # level (1, 2 or 3) and the osquery-toolchain 1.3.0 clang 18 produces a
+      # truncated osquery::getHostname(). The emitted function stops after the
+      # std::vector<char> constructor with no gethostname() call and no return
+      # instruction, so it falls through into the following function and
+      # recurses until the stack is exhausted. "select hostname from
+      # system_info" then segfaults.
+      #
+      # Note this is not a platform limitation: the system GCC on the same
+      # host compiles the same source correctly with fortification on, and
+      # distributions do build s390x userspace with _FORTIFY_SOURCE. The fault
+      # has only been observed with this toolchain and osquery's full flag
+      # set. The toolchain's glibc is 2.17, which predates level 3
+      # (glibc 2.35) and silently clamps it to level 2.
+      #
+      # Leaving _FORTIFY_SOURCE undefined matches what osquery did before
+      # fortification was introduced in 5.24.1.
       list(APPEND posix_common_compile_options
         -U_FORTIFY_SOURCE
-        -D_FORTIFY_SOURCE=3
       )
+
+      if(NOT "${TARGET_PROCESSOR}" STREQUAL "s390x")
+        list(APPEND posix_common_compile_options
+          -D_FORTIFY_SOURCE=3
+        )
+      endif()
     endif()
 
     set(osquery_posix_common_defines
