+/// Extracts the length field from a u128 byte view.
+///
+/// On little-endian, the length is in the low 32 bits.
+/// On big-endian, the length is in the high 32 bits (bytes 0-3 of the view).
+#[cfg(target_endian = "little")]
+#[inline]
+pub fn to_view_length(view: u128) -> u32 {
+    view as u32
+}
+
+/// Extracts the length field from a u128 byte view.
+#[cfg(target_endian = "big")]
+#[inline]
+pub fn to_view_length(view: u128) -> u32 {
+    (view >> 96) as u32
+}
+
+/// Creates a prefix u32 value from 4 raw bytes.
+///
+/// On little-endian, uses from_le_bytes so the prefix sorts correctly in the LE u128.
